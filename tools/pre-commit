#!/bin/sh
# Git pre-commit hook: verify outgoing links before a commit lands.
#
# Install (from the repo root):
#     ln -sf ../../tools/pre-commit .git/hooks/pre-commit
#
# Only runs when HTML is staged. Skips itself when offline. Broken links are
# reported as a warning but never block the commit -- CI keeps a "Broken links"
# issue open as the reminder.

if ! git diff --cached --name-only --diff-filter=ACM | grep -q '\.html$'; then
    exit 0
fi

echo "pre-commit: checking outgoing links..."
python3 tools/check-links.py
# 0 = all alive, 2 = offline (nothing checked); only 1 means a dead link.
if [ $? -ne 1 ]; then
    exit 0
fi

cat <<'EOF'

Warning: at least one link above is broken. Committing anyway --
fix it when you can.

EOF
exit 0
